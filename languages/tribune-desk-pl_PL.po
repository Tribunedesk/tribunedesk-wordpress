#. Plugin Name of the plugin
#: headlinesforge-receiver.php
#: src/WordPress/Settings.php:29
msgid "Tribune Desk"
msgstr "Tribune Desk"

#. Plugin URI of the plugin
#: headlinesforge-receiver.php
msgid "https://github.com/Tribunedesk/tribunedesk-wordpress"
msgstr "https://github.com/Tribunedesk/tribunedesk-wordpress"

#. Description of the plugin
#: headlinesforge-receiver.php
msgid "Receives finished articles from Tribune Desk (ArticleWriter) and creates them as drafts or publishes them immediately."
msgstr "Receives finished articles from Tribune Desk (ArticleWriter) and creates them as drafts or publishes them immediately."

#. Author of the plugin
#: headlinesforge-receiver.php
msgid "Dominik Czarnota"
msgstr "Dominik Czarnota"

#: src/WordPress/Backfill.php:60
msgid "all posts sent; the next click starts from the beginning"
msgstr "wszystkie wpisy wysłane; następne kliknięcie zacznie od początku"

#: src/WordPress/Backfill.php:61
msgid "no published posts from Tribune Desk"
msgstr "brak opublikowanych wpisów z Tribune Desk"

#. translators: %d: number of posts skipped
#: src/WordPress/Backfill.php:105
#, php-format
msgid "skipped %d posts without a UUID"
msgstr "pominięto %d wpisów bez UUID"

#: src/WordPress/Backfill.php:108
msgid "Tribune Desk request limit hit again after the retry — try again in a minute"
msgstr "limit zapytań Tribune Desk także po ponowieniu — spróbuj ponownie za minutę"

#: src/WordPress/Backfill.php:132
#: src/WordPress/CmsSettingsScreen.php:215
msgid "Insufficient permissions."
msgstr "Brak uprawnień."

#: src/WordPress/CmsApiClient.php:118
msgid "The integration is not connected: the CMS API token is missing."
msgstr "Integracja nie jest podłączona: brak tokenu API CMS."

#: src/WordPress/CmsApiClient.php:119
msgid "The Tribune Desk API address must start with https://, so the plugin did not send the token."
msgstr "Adres API Tribune Desk musi zaczynać się od https://, więc wtyczka nie wysłała tokenu."

#: src/WordPress/CmsApiClient.php:120
msgid "Could not connect to Tribune Desk. Try again in a moment."
msgstr "Nie udało się połączyć z Tribune Desk. Spróbuj ponownie za chwilę."

#: src/WordPress/CmsApiClient.php:121
msgid "Tribune Desk rejected the token: it is invalid or revoked."
msgstr "Tribune Desk odrzucił token: jest błędny albo unieważniony."

#: src/WordPress/CmsApiClient.php:122
msgid "The token lacks permission for this operation. Required: articles:write, settings:read, settings:write, media:read, media:write, backfill:write."
msgstr "Token nie ma uprawnień do tej operacji. Potrzebne: articles:write, settings:read, settings:write, media:read, media:write, backfill:write."

#: src/WordPress/CmsApiClient.php:123
msgid "Tribune Desk does not know this object in this organization."
msgstr "Tribune Desk nie zna tego obiektu w tej organizacji."

#: src/WordPress/CmsApiClient.php:124
msgid "The organization in Tribune Desk is frozen and does not accept changes."
msgstr "Organizacja w Tribune Desk jest zamrożona i nie przyjmuje zmian."

#: src/WordPress/CmsApiClient.php:125
msgid "This change was not saved: it includes an option locked by the Tribune Desk administrator."
msgstr "Tej zmiany nie zapisano: obejmuje opcję zablokowaną przez administratora Tribune Desk."

#: src/WordPress/CmsApiClient.php:126
msgid "Tribune Desk cannot do this now: the integration is not enabled or the batch is no longer awaiting a decision. If the batch is too old, reject it and start a new resync."
msgstr "Tribune Desk nie może teraz tego wykonać: integracja nie jest włączona albo paczka nie czeka już na decyzję. Jeśli paczka jest zbyt stara, odrzuć ją i uruchom nowy resync."

#: src/WordPress/CmsApiClient.php:127
msgid "Tribune Desk did not accept these values."
msgstr "Tribune Desk nie przyjął tych wartości."

#: src/WordPress/CmsApiClient.php:128
msgid "The changes cursor expired: fetching is paused until the fields are synced with Tribune Desk."
msgstr "Kursor zmian wygasł: pobieranie stoi, dopóki pola nie zostaną wyrównane z Tribune Desk."

#: src/WordPress/CmsApiClient.php:129
msgid "Too many requests to Tribune Desk. Try again in a moment."
msgstr "Za dużo zapytań do Tribune Desk. Spróbuj ponownie za chwilę."

#: src/WordPress/CmsApiClient.php:131
msgid "Tribune Desk is temporarily unavailable. Try again in a moment."
msgstr "Tribune Desk jest chwilowo niedostępny. Spróbuj ponownie za chwilę."

#: src/WordPress/CmsApiClient.php:132
#: src/WordPress/CmsResync.php:89
#: src/WordPress/CmsResync.php:147
#: src/WordPress/CmsSettingsScreen.php:164
#: src/WordPress/CmsSettingsScreen.php:274
#: src/WordPress/CmsSync.php:302
msgid "Tribune Desk returned an unexpected response."
msgstr "Tribune Desk zwrócił nieoczekiwaną odpowiedź."

#: src/WordPress/CmsBackfill.php:57
msgid "An unexpected plugin error interrupted the import candidates export."
msgstr "Eksport kandydatów importu przerwał nieoczekiwany błąd we wtyczce."

#: src/WordPress/CmsBackfill.php:179
msgid "Tribune Desk rejected the import candidates page, so the plugin will retry it on the next run."
msgstr "Tribune Desk odrzucił stronę kandydatów importu, więc wtyczka ponowi ją przy następnym przebiegu."

#: src/WordPress/CmsBackfill.php:187
msgid "Tribune Desk rejected the import candidates page 5 times in a row, so the plugin paused this task's export for an hour. Check the task in Tribune Desk and the plugin version."
msgstr "Tribune Desk odrzucił stronę kandydatów importu 5 razy z rzędu, więc wtyczka wstrzymała eksport tego zadania na godzinę. Sprawdź zadanie w Tribune Desk i wersję wtyczki."

#: src/WordPress/CmsBackfill.php:195
msgid "The CMS API token lacks the backfill:write permission, so the plugin cannot hand over backfill import candidates. The rest of the exchange works unchanged."
msgstr "Token API CMS nie ma uprawnienia backfill:write, więc wtyczka nie może oddać kandydatów importu wstecznego. Reszta wymiany działa bez zmian."

#. translators: 1: queue limit, 2: number of files
#: src/WordPress/CmsDeletions.php:166
#, php-format
msgid "The deletion report queue reached its limit of %1$d rows, so Tribune Desk will not learn about newer deletions: %2$d."
msgstr "Kolejka zgłoszeń usunięć doszła do limitu %1$d wierszy, więc Tribune Desk nie dowie się o nowszych usunięciach: %2$d."

#: src/WordPress/CmsDeletions.php:256
#: src/WordPress/CmsDeletions.php:258
#: src/WordPress/CmsDeletions.php:312
msgid "Deleted in TD"
msgstr "Usunięte w TD"

#: src/WordPress/CmsDeletions.php:257
#: src/WordPress/CmsDeletions.php:311
msgid "All files"
msgstr "Wszystkie pliki"

#: src/WordPress/CmsResync.php:42
msgid "Choose the sync direction."
msgstr "Wybierz kierunek wyrównania."

#: src/WordPress/CmsResync.php:44
msgid "A sync is already running."
msgstr "Wyrównanie już trwa."

#: src/WordPress/CmsResync.php:48
msgid "Sync started: fields are sent to Tribune Desk in batches in the background."
msgstr "Wyrównanie rozpoczęte: pola idą do Tribune Desk porcjami w tle."

#: src/WordPress/CmsResync.php:72
msgid "There is no preview ready to approve."
msgstr "Nie ma podglądu gotowego do zatwierdzenia."

#: src/WordPress/CmsResync.php:76
msgid "The preview expired (valid for 24 hours). Cancel and start over."
msgstr "Podgląd wygasł (ważny 24 godziny). Zrezygnuj i zacznij od nowa."

#. translators: %s: batch identifier
#: src/WordPress/CmsResync.php:103
#, php-format
msgid "There are more changes than the bulk-change threshold, so Tribune Desk held batch %s. Decide on it in the “Held change batches” section."
msgstr "Zmian jest więcej niż próg masowych zmian, więc Tribune Desk wstrzymał paczkę %s. Zdecyduj o niej w sekcji „Wstrzymane paczki zmian”."

#: src/WordPress/CmsResync.php:105
msgid "Sync approved. The changes feed keeps running."
msgstr "Wyrównanie zatwierdzone. Kanał zmian działa dalej."

#: src/WordPress/CmsResync.php:118
msgid "Sync cancelled. The feed will start from now, and changes from the gap will not arrive."
msgstr "Zrezygnowano z wyrównania. Kanał zacznie od teraz, a zmiany z okresu przerwy nie dotrą."

#: src/WordPress/CmsResync.php:209
msgid "Sync with Tribune Desk"
msgstr "Wyrównanie z Tribune Desk"

#: src/WordPress/CmsResync.php:211
msgid "The changes feed expired: Tribune Desk no longer holds changes since the last fetch. The feed is paused until you sync the fields or cancel. Sending your changes continues."
msgstr "Kanał zmian wygasł: Tribune Desk nie trzyma już zmian od ostatniego pobrania. Kanał stoi, dopóki nie wyrównasz pól albo z tego nie zrezygnujesz. Wysyłka Twoich zmian trwa dalej."

#: src/WordPress/CmsResync.php:216
msgid "WordPress wins: WordPress values will replace differing values in Tribune Desk."
msgstr "Wygrywa WordPress: wartości z WordPressa zastąpią różne wartości w Tribune Desk."

#: src/WordPress/CmsResync.php:218
msgid "Tribune Desk wins: Tribune Desk values will replace differing values in WordPress."
msgstr "Wygrywa Tribune Desk: wartości z Tribune Desk zastąpią różne wartości w WordPressie."

#: src/WordPress/CmsResync.php:219
msgid "Start sync"
msgstr "Zacznij wyrównanie"

#: src/WordPress/CmsResync.php:227
msgid "WordPress wins: differing values in Tribune Desk will be replaced with WordPress values."
msgstr "Wygrywa WordPress: różne wartości w Tribune Desk zostaną zastąpione wartościami z WordPressa."

#: src/WordPress/CmsResync.php:228
msgid "Tribune Desk wins: differing values in WordPress will be replaced with Tribune Desk values."
msgstr "Wygrywa Tribune Desk: różne wartości w WordPressie zostaną zastąpione wartościami z Tribune Desk."

#. translators: %d: id of the last file sent
#: src/WordPress/CmsResync.php:237
#, php-format
msgid "Sending files in batches of 100 (last sent: %d)."
msgstr "Trwa wysyłanie plików porcjami po 100 (ostatni wysłany: %d)."

#: src/WordPress/CmsResync.php:242
msgid "Resume from the saved position"
msgstr "Wznów od zapamiętanego miejsca"

#. translators: %d: number of differences
#: src/WordPress/CmsResync.php:247
#, php-format
msgid "Preview ready. Number of differences: %d."
msgstr "Podgląd gotowy. Liczba różnic: %d."

#: src/WordPress/CmsResync.php:249
msgid "The preview expired (valid for 24 hours): cancel and start over."
msgstr "Podgląd wygasł (ważny 24 godziny): zrezygnuj i zacznij od nowa."

#: src/WordPress/CmsResync.php:254
msgid "Approve sync"
msgstr "Zatwierdź wyrównanie"

#: src/WordPress/CmsResync.php:266
msgid "Cancelling starts the feed from now: changes from the gap will not arrive."
msgstr "Rezygnacja zaczyna kanał od teraz: zmiany z okresu przerwy nie dotrą."

#: src/WordPress/CmsResync.php:267
msgid "Cancel and start from now"
msgstr "Zrezygnuj i zacznij od teraz"

#: src/WordPress/CmsResync.php:296
msgid "You do not have permission."
msgstr "Brak uprawnień."

